# Copy to .env and point these at your own folders.
# Windows paths work with forward slashes: C:/Users/you/Scans
SCANS=./scans
OUT=./out
# Where bench keeps projects (read-write). SCANS is only an import source.
PROJECTS=./projects

# Must match __version__ in open_point_stitch/__init__.py. Only docker-compose.yml reads this; the launchers read
# __version__ directly.
STITCH_VERSION=0.50.1

# CPU threads a run may use. 32 means "don't cap it".
THREADS=32
